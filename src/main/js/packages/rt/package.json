{
  "name": "@effectful/kafka-workflow-rt",
  "version": "0.1.0",
  "description": "Small runtime helpers for durable JavaScript workflows on Kafka Streams",
  "main": "lib/main.js",
  "types": "lib/main.d.ts",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "require": "./lib/main.js",
      "default": "./lib/main.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awto/kafka-workflow.git",
    "directory": "src/main/js/packages/rt"
  },
  "homepage": "https://github.com/awto/kafka-workflow#readme",
  "bugs": {
    "url": "https://github.com/awto/kafka-workflow/issues"
  },
  "keywords": [
    "workflow",
    "workflow-as-code",
    "durable-functions",
    "kafka",
    "kafka-streams",
    "continuations",
    "saga",
    "effectful"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.js"
  },
  "dependencies": {
    "@effectful/cc": "^2.0.11",
    "@effectful/serialization": "^2.0.11",
    "promise": "^8.3.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^25.6.0"
  }
}
